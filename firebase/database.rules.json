{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "sessions": {
      "$sessionId": {
        ".read": "auth != null",
        "players": {
          "$playerId": {
            ".write": "auth != null && auth.uid == $playerId",
            ".validate": "newData.hasChildren(['joinedAt'])"
          }
        },
        "globalHealth": {
          ".read": "auth != null",
          ".write": false
        },
        "certificates": {
          "$certId": {
            ".read": "auth != null",
            ".write": false
          }
        },
        "ledger": {
          ".read": "auth != null",
          ".write": false
        },
        "auditLog": {
          ".read": "auth != null",
          ".write": false
        },
        ".write": false
      }
    },
    "activeProblems": {
      "$sessionId": {
        "$playerId": {
          ".read": "auth != null && auth.uid == $playerId",
          ".write": false
        }
      }
    }
  }
}
