# Copy to .env.local (never commit secrets)

# Turso: `turso db create last-of-os` then `turso db show last-of-os --url` / `turso db tokens create last-of-os`
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

# Clerk (dashboard.clerk.com > your app > API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Random 32+ byte string: `openssl rand -base64 32`
SESSION_SECRET=

# Comma-separated emails that can open /admin
ADMIN_EMAILS=you@vitstudent.ac.in

# --- Tooling only (the app itself does not read these) ---
# Lets Claude Code / the Vercel CLI check deployments, env vars and logs.
# Put real values in .env.local (or .env); both are git-ignored. Never commit them.
# Create the token at https://vercel.com/account/tokens (set a short expiry).
VERCEL_TOKEN=
# Found in .vercel/project.json after `npx vercel link`, or Project Settings > General
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
